# Copy to .env. Never commit .env or expose the jury key in frontend code.
FORTE_ENVIRONMENT=development
# Leave empty in source control. Generate a local key with:
# python infra/generate_jury_key.py
FORTE_API_KEY=
FORTE_DATA_DIR=./data
FORTE_DEADLINE_SECONDS=300
FORTE_MAX_UPLOAD_MB=64
FORTE_MAX_PENDING_JOBS=5
FORTE_PROFILE=standard
FORTE_WORKER_POLL_SEC=0.2
FORTE_MAX_ATTEMPTS=3

# The development adapter deliberately fails analysis until real ML is connected.
# Production requires your real analyzer and rules factories.
FORTE_ANALYZER_FACTORY=backend.adapters.unavailable:create_analyzer
FORTE_RULES_FACTORY=backend.adapters.unavailable:create_rules

# Use absolute executable paths if FFmpeg is not in PATH.
FORTE_FFMPEG_BIN=ffmpeg
FORTE_FFPROBE_BIN=ffprobe
FORTE_FRONTEND_DIST=./frontend/dist
