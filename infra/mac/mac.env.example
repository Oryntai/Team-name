# Образец настроек для infra/mac/serve.sh. Скопировать вне git (например, в local_data/mac.env)
# и заполнить. Файл подключается через bash `source`, поэтому значения — в синтаксисе shell.

# Python окружения, где установлены backend, decision, vision[mlx,detector] и data_tools
FORTE_PYTHON=/path/to/.venv/bin/python
FORTE_LOG_DIR=/path/to/local_data/logs
export FORTE_DATA_DIR=/path/to/local_data/service
export FORTE_ENVIRONMENT=production
# Ключ жюри — из файла, не в открытом виде здесь (python infra/generate_jury_key.py)
export FORTE_API_KEY="$(cat /path/to/local_data/.api_key)"

export FORTE_ANALYZER_FACTORY=forte_vision.backend_adapter:create_analyzer
export FORTE_RULES_FACTORY=forte_decision.backend_adapter:create_rules
export FORTE_RULE_CATALOGS='["rules/cash_checks.json"]'

# Модель: сервер на GPU-машине через туннель, при сбое — локальная MLX
export FORTE_VLM_BACKEND=openai+mlx FORTE_VLM_MODEL=qwen3vl-8b
export FORTE_VLM_FALLBACK_MODEL=mlx-community/Qwen3-VL-8B-Instruct-4bit
export FORTE_VLM_URL=http://127.0.0.1:18080 FORTE_VLM_KEY_FILE=/path/to/local_data/.vlm_key FORTE_VLM_RETRY_SEC=30
export FORTE_DETECTOR=nano FORTE_VISION_PROFILE=fast
export HF_HOME=/path/to/local_data/hf HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 TQDM_DISABLE=1 PYTORCH_ENABLE_MPS_FALLBACK=1

# Туннель до публичного сервера: пользователь только с пробросами 127.0.0.1:18000 (-R) и 18080 (-L)
FORTE_TUNNEL_HOST=203.0.113.10
FORTE_TUNNEL_USER=forte-tunnel
FORTE_TUNNEL_KEY=$HOME/.ssh/forte_tunnel_ed25519
FORTE_TUNNEL_REMOTE_PORT=18000
FORTE_TUNNEL_VLM_PORT=18080

# Автодеплой
FORTE_DEPLOY_INTERVAL=60
FORTE_DEPLOY_IDLE_WAIT=900
