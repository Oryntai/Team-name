{
  "openapi": "3.1.0",
  "info": {
    "title": "ForteBank Video Analysis",
    "version": "0.1.0"
  },
  "paths": {
    "/ui-api/key": {
      "get": {
        "summary": "Public Key",
        "description": "The shared jury key shown on the API page: created on first request, the same value afterwards.",
        "operationId": "public_key_ui_api_key_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IssuedApiKey"
                }
              }
            }
          }
        }
      }
    },
    "/ui-api/analyze": {
      "post": {
        "summary": "Analyze",
        "operationId": "analyze_ui_api_analyze_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_analyze_ui_api_analyze_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobAccepted"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/analyze": {
      "post": {
        "summary": "Analyze",
        "operationId": "analyze_api_v1_analyze_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_analyze_api_v1_analyze_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobAccepted"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    },
    "/ui-api/jobs/{job_id}": {
      "get": {
        "summary": "Get Job",
        "operationId": "get_job_ui_api_jobs__job_id__get",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/JobProcessing"
                    },
                    {
                      "$ref": "#/components/schemas/JobFailed"
                    },
                    {
                      "$ref": "#/components/schemas/JobDone"
                    }
                  ],
                  "title": "Response Get Job Ui Api Jobs  Job Id  Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/jobs/{job_id}": {
      "get": {
        "summary": "Get Job",
        "operationId": "get_job_api_v1_jobs__job_id__get",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/JobProcessing"
                    },
                    {
                      "$ref": "#/components/schemas/JobFailed"
                    },
                    {
                      "$ref": "#/components/schemas/JobDone"
                    }
                  ],
                  "title": "Response Get Job Api V1 Jobs  Job Id  Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Body_analyze_api_v1_analyze_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_analyze_api_v1_analyze_post"
      },
      "Body_analyze_ui_api_analyze_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_analyze_ui_api_analyze_post"
      },
      "EvidenceFrame": {
        "properties": {
          "timestamp_sec": {
            "type": "number",
            "minimum": 0.0,
            "title": "Timestamp Sec"
          },
          "image_base64": {
            "type": "string",
            "minLength": 1,
            "title": "Image Base64"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "timestamp_sec",
          "image_base64"
        ],
        "title": "EvidenceFrame"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "IssuedApiKey": {
        "properties": {
          "api_key": {
            "type": "string",
            "title": "Api Key"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "api_key"
        ],
        "title": "IssuedApiKey"
      },
      "JobAccepted": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "job_id"
        ],
        "title": "JobAccepted"
      },
      "JobDone": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id"
          },
          "status": {
            "type": "string",
            "const": "done",
            "title": "Status",
            "default": "done"
          },
          "verdict": {
            "type": "string",
            "enum": [
              "violation",
              "no_violation"
            ],
            "title": "Verdict"
          },
          "violations": {
            "items": {
              "$ref": "#/components/schemas/Violation"
            },
            "type": "array",
            "title": "Violations"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "job_id",
          "verdict",
          "violations"
        ],
        "title": "JobDone"
      },
      "JobFailed": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id"
          },
          "status": {
            "type": "string",
            "const": "failed",
            "title": "Status",
            "default": "failed"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "job_id"
        ],
        "title": "JobFailed"
      },
      "JobProcessing": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id"
          },
          "status": {
            "type": "string",
            "const": "processing",
            "title": "Status",
            "default": "processing"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "job_id"
        ],
        "title": "JobProcessing"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "Violation": {
        "properties": {
          "type": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Type"
          },
          "timecode_sec": {
            "type": "number",
            "minimum": 0.0,
            "title": "Timecode Sec"
          },
          "description": {
            "type": "string",
            "maxLength": 8000,
            "minLength": 1,
            "title": "Description"
          },
          "evidence_frames": {
            "items": {
              "$ref": "#/components/schemas/EvidenceFrame"
            },
            "type": "array",
            "maxItems": 3,
            "minItems": 1,
            "title": "Evidence Frames"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "type",
          "timecode_sec",
          "description",
          "evidence_frames"
        ],
        "title": "Violation"
      }
    },
    "securitySchemes": {
      "APIKeyHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    }
  }
}
