      "type": "number"
    },
    "profile": {
      "default": "standard",
      "title": "Profile",
      "type": "string"
    },
    "analysis_budget_sec": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
